# Copy this file to .env.local for development, or set the same variables in
# your Cloudflare Pages project settings → Environment variables.
#
# All values are optional — when unset, the defaults below are used so local
# development works out of the box.

# Google Analytics 4 measurement ID (gtag.js)
NEXT_PUBLIC_GA_ID=G-KLVBV8S58R

# Google AdSense publisher client ID (the ca-pub-... portion of the URL)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1719881162787470

# Bing Webmaster Tools verification token (msvalidate.01 meta tag)
NEXT_PUBLIC_MSVALIDATE=1FDBEDECCADE86F6C58D3B85E9492A14

# Security headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Static JS/CSS assets - long cache (immutable via content hash)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images
# Note: s-maxage kept at 1 day (not the usual 7-day immutable) so that if
# Cloudflare Pages' SPA fallback serves an HTML 404 for a not-yet-deployed
# image path (e.g. a new file that the CDN hasn't seen), the bad response
# only pollutes the cache for at most 24h instead of 7d. Real images benefit
# from browser caching via max-age; the CDN layer is intentionally shorter.
/images/*
  Cache-Control: public, max-age=86400, s-maxage=86400

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=3600

# Robots
/robots.txt
  Cache-Control: public, max-age=3600

# IndexNow key
/113be43db95093ec0475d10e2f342d8c.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

# Sub-sitemaps
/sitemap-pages.xml
  Cache-Control: public, max-age=3600
/sitemap-characters.xml
  Cache-Control: public, max-age=3600
/sitemap-weapons.xml
  Cache-Control: public, max-age=3600
/sitemap-guides.xml
  Cache-Control: public, max-age=3600
/sitemap-other.xml
  Cache-Control: public, max-age=3600

# 404 / not-found pages — never index if the not-found asset is requested
# directly. Unsupported language prefixes are handled by _redirects with a 404
# status instead of an X-Robots-Tag so GSC classifies them as removed URLs, not
# "Excluded by noindex".
/_not-found/*
  X-Robots-Tag: noindex, follow

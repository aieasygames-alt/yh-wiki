# Security headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Static JS/CSS assets - long cache (immutable via content hash)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images
/images/*
  Cache-Control: public, max-age=86400, s-maxage=604800

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=3600

# Robots
/robots.txt
  Cache-Control: public, max-age=3600

# IndexNow key
/113be43db95093ec0475d10e2f342d8c.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

# Sub-sitemaps
/sitemap-pages.xml
  Cache-Control: public, max-age=3600
/sitemap-characters.xml
  Cache-Control: public, max-age=3600
/sitemap-weapons.xml
  Cache-Control: public, max-age=3600
/sitemap-guides.xml
  Cache-Control: public, max-age=3600
/sitemap-other.xml
  Cache-Control: public, max-age=3600

# 404 / not-found pages — never index. CF Pages SPA fallback returns 200 for
# unmatched routes with the Next.js error body, so without this Google would
# index empty error pages (e.g. /ja/* /de/* language variants). The X-Robots-Tag
# header covers all error-page responses regardless of how the route was reached.
/_not-found/*
  X-Robots-Tag: noindex, follow

# Unsupported language prefixes (/ja /de /fr /es /ru /th /vi /id /ko /pt-br)
# CF Pages SPA fallback serves these as 200 with __next_error__ body and the
# root layout's robots=index,follow — Google would index 18k+ empty pages.
# _redirects 404 rules don't trigger (SPA fallback wins), so force noindex here.
/ja/*
  X-Robots-Tag: noindex, follow
/de/*
  X-Robots-Tag: noindex, follow
/fr/*
  X-Robots-Tag: noindex, follow
/es/*
  X-Robots-Tag: noindex, follow
/ru/*
  X-Robots-Tag: noindex, follow
/th/*
  X-Robots-Tag: noindex, follow
/vi/*
  X-Robots-Tag: noindex, follow
/id/*
  X-Robots-Tag: noindex, follow
/ko/*
  X-Robots-Tag: noindex, follow
/pt-br/*
  X-Robots-Tag: noindex, follow
